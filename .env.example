# 複製成 .env.local（不會進 git）
# 網頁用（公開的，GitHub Pages 也要在 repo Variables 設同名變數）
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# 只給 `make seed` 和本機的檢查腳本用，不會進網頁。這把金鑰可以繞過所有權限，不要貼給任何人。
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# `make seed` 印邀請連結時用的網址
SITE_URL=https://<你的帳號>.github.io/nexttrip/
# seed/trip.ts 沒有寫 TRIP.id 的時候，用這個找既有的行程
# TRIP_ID=00000000-0000-0000-0000-000000000000

# Google 登入（Google Cloud Console 的 OAuth client），用 make auth-push 推到 Supabase
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
